{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicoder:rpc:v1",
  "title": "aicoder stdio RPC v1",
  "description": "Wire frames; monotonic IDs, run ownership, control semantics and limits are enforced by the host. Core event lifecycle uses EventTraceValidator. See docs/rpc.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/observation_error"
    },
    {
      "$ref": "#/$defs/run_finished"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "command": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "initialize"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "status"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "permissions"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "revoke"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "shutdown"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "prompt"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "steer"
                },
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "follow_up"
                },
                "run_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "run_id",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "cancel"
                },
                "run_id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "run_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "approve"
                },
                "run_id": {
                  "type": "string"
                },
                "approval_id": {
                  "type": "object",
                  "properties": {
                    "run_id": {
                      "type": "string"
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  },
                  "required": [
                    "run_id",
                    "sequence"
                  ],
                  "additionalProperties": true
                },
                "decision": {
                  "enum": [
                    "deny",
                    "allow_once",
                    "allow_session"
                  ]
                }
              },
              "required": [
                "type",
                "run_id",
                "approval_id",
                "decision"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "select_session"
                },
                "session_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "session_tree"
                },
                "session_id": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "cursor": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "session_id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        }
                      },
                      "required": [
                        "session_id",
                        "revision",
                        "offset"
                      ],
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "session_id",
                "limit"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "session_search"
                },
                "session_id": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "cursor": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "session_id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        "query": {
                          "type": "string"
                        },
                        "entry": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        "block": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 18446744073709551615
                        }
                      },
                      "required": [
                        "session_id",
                        "revision",
                        "query",
                        "entry",
                        "block",
                        "offset"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "session_id",
                "query",
                "limit"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "id",
        "command"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "type": {
              "const": "response"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": true
            },
            "result": {
              "type": "object"
            }
          },
          "required": [
            "version",
            "type",
            "id",
            "ok",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "type": {
              "const": "response"
            },
            "id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "invalid_request",
                    "invalid_id",
                    "stale_id",
                    "unsupported_version",
                    "invalid_command",
                    "busy",
                    "unknown_run",
                    "control_rejected",
                    "command_failed"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "type",
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "$ref": "urn:aicoder:events:v1"
        }
      },
      "required": [
        "version",
        "type",
        "event"
      ],
      "additionalProperties": false
    },
    "observation_error": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "observation_error"
        },
        "run_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "observer_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "first_missing_sequence": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_delivered_sequence": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "observer_id",
            "first_missing_sequence",
            "last_delivered_sequence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "type",
        "run_id",
        "error"
      ],
      "additionalProperties": false
    },
    "run_finished": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "run_finished"
        },
        "result": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "session_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "completed",
                "aborted",
                "limited",
                "stopped",
                "failed"
              ]
            },
            "stop": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "persistence_error": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "usage": {
              "type": "object"
            },
            "tokens": {
              "type": "object"
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "elapsed_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "model_context": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "event_delivery": {
              "type": "object"
            },
            "pending_inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string"
                  },
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  "kind": {
                    "enum": [
                      "steer",
                      "follow_up"
                    ]
                  }
                },
                "required": [
                  "run_id",
                  "id",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "run_id",
            "session_id",
            "status",
            "stop",
            "persistence_error",
            "rounds",
            "tool_calls",
            "usage",
            "tokens",
            "output_bytes",
            "elapsed_ms",
            "model_context",
            "event_delivery",
            "pending_inputs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "type",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
