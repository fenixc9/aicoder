# Choose one credential source; no placeholder key is active by default.
# OpenAI (built-in profile default model: gpt-4o)
# OPENAI_API_KEY=...
# AICODER_MODEL=...

# DeepSeek (native compatible endpoint + deepseek-flash + thinking profile)
# DEEPSEEK_API_KEY=...
# AICODER_MODEL=deepseek-flash
# AICODER_COMPATIBILITY=deepseek-chat

# Other OpenAI-compatible gateways: endpoint and model must be explicit.
# AICODER_API_BASE=https://gateway.example/v1
# AICODER_API_KEY_ENV=MY_MODEL_TOKEN
# MY_MODEL_TOKEN=...
# AICODER_MODEL=coding-model
# AICODER_PROVIDER_ID=work-gateway
# AICODER_COMPATIBILITY=generic

# auto follows HTTP(S)_PROXY/ALL_PROXY/NO_PROXY. Use disabled for direct access.
# AICODER_PROXY=auto
# AICODER_PROXY=disabled
# AICODER_PROXY=http://127.0.0.1:7890
# AICODER_HTTP_TIMEOUT=120
# AICODER_CONNECT_TIMEOUT=10
# AICODER_MAX_RETRIES=3
# AICODER_STREAM_USAGE=true
# AICODER_MAX_RESPONSE_BYTES=33554432
